# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
CI_ENVIRONMENT=production

# --------------------------------------------------------------------
# APP
# --------------------------------------------------------------------
app.baseURL = 'https://presensi.smauiiyk.sch.id/'
app.forceGlobalSecureRequests = true

# --------------------------------------------------------------------
# DATABASE - PostgreSQL (NeonDB or other)
# --------------------------------------------------------------------
database.default.hostname = your-hostname
database.default.database = your-database
database.default.username = your-username
database.default.password = your-password
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.DBPrefix =
database.default.charset = utf8

# --------------------------------------------------------------------
# SESSION - DatabaseHandler (uses ci_sessions table)
# --------------------------------------------------------------------
app.sessionDriver = CodeIgniter\Session\Handlers\DatabaseHandler
app.sessionSavePath = ci_sessions
app.sessionMatchIP = false

# --------------------------------------------------------------------
# EMAIL - SMTP Configuration
# --------------------------------------------------------------------
email.fromEmail = no-reply@yourdomain.com
email.SMTPUser = your-smtp-username
email.SMTPPass = your-smtp-password
email.SMTPHost = smtp.yourdomain.com
email.SMTPPort = 465
email.SMTPCrypto = ssl

# --------------------------------------------------------------------
# CSRF
# --------------------------------------------------------------------
app.CSRFEnabled = true
app.CSRFTokenName = csrf_test_name
app.CSRFCookieName = csrf_cookie_name
app.CSRFExpire = 7200

# --------------------------------------------------------------------
# LOGGING
# --------------------------------------------------------------------
app.logThreshold = 1