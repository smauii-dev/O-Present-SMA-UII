{# Lokasi list fragment #}
{% if lokasi is empty %}
<div class="card p-8 text-center">
  <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
  </svg>
  <p class="mt-3 text-sm text-gray-500">Belum ada data lokasi</p>
</div>
{% else %}
{# Mobile cards #}
<div class="sm:hidden space-y-2">
  {% for item in lokasi %}
  <div class="card p-4">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-sm font-medium text-gray-900">{{ item.nama_lokasi }}</p>
          <span class="badge {{ item.tipe_lokasi == 'Pusat' ? 'badge-primary' : 'badge-gray' }}">{{ item.tipe_lokasi }}</span>
        </div>
        <p class="mt-1 text-xs text-gray-500">{{ item.alamat_lokasi }}</p>
        <p class="mt-1 font-mono text-[11px] text-gray-400">{{ item.latitude }}, {{ item.longitude }}</p>
        <div class="mt-2 flex flex-wrap gap-3 text-xs text-gray-500">
          <span>{{ item.jam_masuk|slice(0,5) }}–{{ item.jam_pulang|slice(0,5) }}</span>
          <span>r={{ item.radius }}m</span>
        </div>
      </div>
      <div class="row-actions shrink-0">
        <button type="button" hx-get="/admin/lokasi/form/{{ item.id }}" hx-target="#modal-host" class="icon-btn" title="Edit">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
        </button>
        <button type="button" hx-delete="/admin/lokasi/{{ item.id }}" hx-confirm="Yakin ingin menghapus lokasi ini?" hx-swap="none" class="icon-btn icon-btn-danger" title="Hapus">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
        </button>
      </div>
    </div>
  </div>
  {% endfor %}
</div>

{# Desktop table #}
<div class="hidden sm:block card overflow-hidden">
  <div class="overflow-x-auto w-full">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-3">Nama Lokasi</th>
          <th class="px-4 py-3">Koordinat</th>
          <th class="px-4 py-3">Tipe</th>
          <th class="px-4 py-3">Jam</th>
          <th class="px-4 py-3">Radius</th>
          <th class="px-4 py-3">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% for item in lokasi %}
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <p class="font-medium text-gray-900">{{ item.nama_lokasi }}</p>
            <p class="text-xs text-gray-500 truncate max-w-[220px]">{{ item.alamat_lokasi }}</p>
          </td>
          <td class="px-4 py-3 font-mono text-xs text-gray-600 whitespace-nowrap">
            {{ item.latitude }}, {{ item.longitude }}
          </td>
          <td class="px-4 py-3"><span class="badge {{ item.tipe_lokasi == 'Pusat' ? 'badge-primary' : 'badge-gray' }}">{{ item.tipe_lokasi }}</span></td>
          <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{{ item.jam_masuk|slice(0,5) }}–{{ item.jam_pulang|slice(0,5) }}</td>
          <td class="px-4 py-3 text-gray-600">{{ item.radius }}m</td>
          <td class="px-4 py-3">
            <div class="row-actions">
              <button type="button" hx-get="/admin/lokasi/form/{{ item.id }}" hx-target="#modal-host" class="icon-btn" title="Edit">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
              </button>
              <button type="button" hx-delete="/admin/lokasi/{{ item.id }}" hx-confirm="Yakin ingin menghapus lokasi ini?" hx-swap="none" class="icon-btn icon-btn-danger" title="Hapus">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
              </button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}
