{% extends 'layouts/app.twig' %}
{% block content %}
{#
  Alpine x-data JANGAN diisi object multi-line + json_encode di dalam atribut HTML.
  Tanda " dari JSON memutus atribut → SyntaxError / current is not defined.
  Pola aman: data di <script type="application/json"> + x-data="profileForm($el)".
#}
{% set profilePayload = {
  initial: {
    nama: authUser.nama ?? '',
    no_handphone: authUser.no_handphone ?? '',
    jenis_kelamin: authUser.jenis_kelamin ?? 'Laki-laki',
    alamat: authUser.alamat ?? ''
  },
  current: {
    nama: old('nama', authUser.nama ?? ''),
    no_handphone: old('no_handphone', authUser.no_handphone ?? ''),
    jenis_kelamin: old('jenis_kelamin', authUser.jenis_kelamin ?? 'Laki-laki'),
    alamat: old('alamat', authUser.alamat ?? '')
  }
} %}

{% if authUser and authUser.force_pass_reset %}
<div x-data="forcePasswordModal()" x-init="open = true" class="fixed inset-0 z-50" x-cloak>
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" @click="open = false"></div>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4" @click.outside="open = false">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl" @click.outside="false">
      <div class="text-center mb-6">
        <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-warning-100 text-warning-600">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900">Ganti Password Wajib</h3>
        <p class="mt-2 text-sm text-gray-500">Akun Anda masih menggunakan password default. Silakan ganti password untuk keamanan.</p>
      </div>

      <form action="/profile/password/force" method="POST" class="space-y-4" @submit="loading = true">
        {{ csrf_field()|raw }}
        <div>
          <label class="mb-1.5 block text-sm font-semibold text-gray-700">Password Baru</label>
          <input type="password" name="password_baru" x-model="newPass" required minlength="8" autocomplete="new-password"
                 class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-warning-500 focus:bg-white focus:ring-2 focus:ring-warning-500/20">
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-semibold text-gray-700">Ulangi Password Baru</label>
          <input type="password" name="password_confirm" x-model="confPass" required minlength="8" autocomplete="new-password"
                 class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-warning-500 focus:bg-white focus:ring-2 focus:ring-warning-500/20"
                 :class="{ 'border-danger-500 focus:border-danger-500 focus:ring-danger-500/20': mismatch }">
          <p x-cloak x-show="mismatch" class="mt-1.5 text-xs text-danger-600">Konfirmasi password tidak cocok!</p>
        </div>

        <div class="mt-6">
          <button type="submit" class="btn btn-warning w-full" :disabled="loading || !isDirty || mismatch">
            <svg x-cloak x-show="loading" class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <span x-text="loading ? 'Menyimpan...' : 'Simpan & Lanjutkan'">Simpan & Lanjutkan</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endif %}

<div class="mx-auto max-w-4xl space-y-6 pb-12">
  {# Profile header #}
  <div class="card overflow-hidden border border-gray-100 shadow-xl shadow-gray-200/40">
    <div class="h-32 w-full bg-gradient-to-r from-primary-600 to-primary-400 sm:h-40"></div>
    <div class="relative px-6 pb-8 sm:px-10">
      <div class="-mt-16 flex flex-col sm:flex-row sm:items-end sm:gap-6">
        <div class="group relative z-10 mx-auto sm:mx-0">
          <div class="relative h-32 w-32 overflow-hidden rounded-full border-4 border-white bg-white shadow-lg ring-1 ring-black/5">
            {% if authUser and authUser.foto_url %}
              <img src="{{ authUser.foto_url }}" alt="Profile" class="h-full w-full object-cover">
            {% else %}
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100 text-5xl font-bold text-primary-700">{{ authUser.nama|first|upper }}</div>
            {% endif %}

            <form action="/profile/photo" method="POST" enctype="multipart/form-data"
                  class="absolute inset-0"
                  x-data="{ loading: false }"
                  @submit="loading = true">
              {{ csrf_field()|raw }}
              <label class="flex h-full w-full cursor-pointer items-center justify-center bg-black/40 opacity-0 backdrop-blur-sm transition-all duration-300 group-hover:opacity-100 rounded-full"
                     :class="{ 'opacity-100': loading }">
                <svg x-show="!loading" class="h-8 w-8 text-white transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <svg x-cloak x-show="loading" class="h-8 w-8 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
                <input type="file" name="foto" accept="image/*" class="hidden" @change="$el.form.requestSubmit()">
              </label>
            </form>
          </div>
        </div>

        <div class="mt-4 flex-1 text-center sm:mt-0 sm:pb-3 sm:text-left">
          <h1 class="text-3xl font-black tracking-tight text-gray-900">{{ authUser.nama }}</h1>
          <div class="mt-1 flex flex-col items-center justify-center gap-2 sm:flex-row sm:justify-start sm:gap-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700 ring-1 ring-inset ring-primary-600/20">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z" /></svg>
              NIP: {{ authUser.nip }}
            </span>
            <span class="flex items-center gap-1.5 text-sm font-medium text-gray-500">
              <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              {{ authUser.email }}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="card border border-gray-100 p-6 shadow-lg shadow-gray-200/30 sm:p-8">
        <div class="mb-6 border-b border-gray-100 pb-4">
          <h2 class="flex items-center gap-2 text-xl font-bold text-gray-900">
            <svg class="h-6 w-6 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            Informasi Pribadi
          </h2>
          <p class="mt-1 text-sm text-gray-500">Perbarui informasi data diri dan kontak Anda.</p>
        </div>

        <script type="application/json" id="profile-form-data">{{ profilePayload|json_encode|raw }}</script>

        <form action="/profile/update" method="POST" class="space-y-5"
              x-data="profileForm()"
              @submit="loading = true">
          {{ csrf_field()|raw }}

          <div>
            <label class="mb-1.5 block text-sm font-semibold text-gray-700">Nama Lengkap</label>
            <input type="text" name="nama" x-model="current.nama" required
                   class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-primary-500 focus:bg-white focus:ring-2 focus:ring-primary-500/20">
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label class="mb-1.5 block text-sm font-semibold text-gray-700">No. Handphone</label>
              <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
                </div>
                <input type="tel" name="no_handphone" x-model="current.no_handphone"
                       class="block w-full rounded-xl border-gray-300 bg-gray-50 py-3 pl-10 pr-4 text-sm text-gray-900 transition-colors focus:border-primary-500 focus:bg-white focus:ring-2 focus:ring-primary-500/20">
              </div>
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-semibold text-gray-700">Jenis Kelamin</label>
              <select name="jenis_kelamin" x-model="current.jenis_kelamin"
                      class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-primary-500 focus:bg-white focus:ring-2 focus:ring-primary-500/20">
                <option value="Laki-laki">Laki-laki</option>
                <option value="Perempuan">Perempuan</option>
              </select>
            </div>
          </div>

          <div>
            <label class="mb-1.5 block text-sm font-semibold text-gray-700">Alamat Tempat Tinggal</label>
            <textarea name="alamat" rows="3" x-model="current.alamat"
                      class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-primary-500 focus:bg-white focus:ring-2 focus:ring-primary-500/20"></textarea>
          </div>

          <div class="mt-8 flex justify-end">
            <button type="submit"
                    class="btn btn-primary"
                    :disabled="loading || !isDirty">
              <svg x-cloak x-show="loading" class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
              <span x-text="loading ? 'Menyimpan...' : 'Simpan Perubahan'">Simpan Perubahan</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="lg:col-span-1">
      <div class="card border border-gray-100 p-6 shadow-lg shadow-gray-200/30">
        <div class="mb-6 border-b border-gray-100 pb-4">
          <h2 class="flex items-center gap-2 text-xl font-bold text-gray-900">
            <svg class="h-6 w-6 text-warning-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
            Keamanan
          </h2>
          <p class="mt-1 text-sm text-gray-500">Ubah kata sandi akun Anda secara berkala.</p>
        </div>

        <form action="/profile/password" method="POST" class="space-y-4"
              x-data="passwordForm()"
              @submit="loading = true">
          {{ csrf_field()|raw }}

          <div>
            <label class="mb-1.5 block text-sm font-semibold text-gray-700">Password Lama</label>
            <input type="password" name="password_lama" x-model="oldPass" required autocomplete="current-password"
                   class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-warning-500 focus:bg-white focus:ring-2 focus:ring-warning-500/20">
          </div>

          <div class="space-y-4">
            <div>
              <label class="mb-1.5 block text-sm font-semibold text-gray-700">Password Baru</label>
              <input type="password" name="password_baru" x-model="newPass" required minlength="8" autocomplete="new-password"
                     class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-warning-500 focus:bg-white focus:ring-2 focus:ring-warning-500/20">
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-semibold text-gray-700">Ulangi Password Baru</label>
              <input type="password" name="password_confirm" x-model="confPass" required minlength="8" autocomplete="new-password"
                     class="block w-full rounded-xl border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 transition-colors focus:border-warning-500 focus:bg-white focus:ring-2 focus:ring-warning-500/20"
                     :class="{ 'border-danger-500 focus:border-danger-500 focus:ring-danger-500/20': mismatch }">
              <p x-cloak x-show="mismatch" class="mt-1.5 text-xs text-danger-600">Konfirmasi password tidak cocok!</p>
            </div>
          </div>

          <div class="mt-6">
            <button type="submit"
                    class="btn btn-dark w-full"
                    :disabled="loading || !isDirty || mismatch">
              <svg x-cloak x-show="loading" class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
              <span x-text="loading ? 'Memproses...' : 'Perbarui Password'">Perbarui Password</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function profileForm() {
  const el = document.getElementById('profile-form-data');
  let data = { initial: {}, current: {} };
  try {
    data = JSON.parse(el ? el.textContent : '{}');
  } catch (e) {
    console.error('profile-form-data JSON invalid', e);
  }

  const initial = {
    nama: data.initial?.nama ?? '',
    no_handphone: data.initial?.no_handphone ?? '',
    jenis_kelamin: data.initial?.jenis_kelamin ?? 'Laki-laki',
    alamat: data.initial?.alamat ?? '',
  };

  return {
    loading: false,
    initial: { ...initial },
    current: {
      nama: data.current?.nama ?? initial.nama,
      no_handphone: data.current?.no_handphone ?? initial.no_handphone,
      jenis_kelamin: data.current?.jenis_kelamin ?? initial.jenis_kelamin,
      alamat: data.current?.alamat ?? initial.alamat,
    },
    get isDirty() {
      return this.initial.nama !== this.current.nama
        || this.initial.no_handphone !== this.current.no_handphone
        || this.initial.jenis_kelamin !== this.current.jenis_kelamin
        || this.initial.alamat !== this.current.alamat;
    },
  };
}

function passwordForm() {
  return {
    loading: false,
    oldPass: '',
    newPass: '',
    confPass: '',
    get isDirty() {
      return this.oldPass.length > 0 && this.newPass.length >= 8 && this.confPass.length >= 8;
    },
    get mismatch() {
      return this.confPass.length > 0 && this.confPass !== this.newPass;
    },
  };
}

function forcePasswordModal() {
  return {
    open: false,
    loading: false,
    newPass: '',
    confPass: '',
    get isDirty() {
      return this.newPass.length >= 8 && this.confPass.length >= 8;
    },
    get mismatch() {
      return this.confPass.length > 0 && this.confPass !== this.newPass;
    },
  };
}
</script>
{% endblock %}