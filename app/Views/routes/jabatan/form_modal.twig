{% import 'partials/form_modal.twig' as fm %}
{{ fm.formModal('jabatan', jabatan ? 'Edit Jabatan' : 'Tambah Jabatan', 'md', '/admin/jabatan', jabatan, schemaName='jabatan') }}
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1.5">Nama Jabatan</label>
      <input type="text" name="jabatan" value="{{ jabatan.jabatan ?? '' }}" required placeholder="Contoh: Guru, Staf, Kepala Sekolah" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20"
        @blur="validateField('jabatan', $el.value)">
      <template x-if="hasError('jabatan')">
        <p class="mt-1 text-xs text-danger-600" x-text="getError('jabatan')"></p>
      </template>
    </div>
  </div>
  <div class="modal-actions mt-4 flex justify-end gap-2.5">
    <button type="button" @click="$dispatch('close-modal')" class="btn btn-secondary btn-sm">Batal</button>
    <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
  </div>
{{ fm.end() }}