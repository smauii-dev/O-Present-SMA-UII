{# Jabatan list fragment #}
{% if jabatan is empty %}
<div class="card p-8 text-center">
  <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
  </svg>
  <p class="mt-3 text-sm text-gray-500">Belum ada data jabatan</p>
</div>
{% else %}
<div class="card overflow-hidden">
  {# Mobile #}
  <div class="sm:hidden divide-y divide-gray-100">
    {% for item in jabatan %}
    <div class="flex items-center justify-between p-4" x-data>
      <div>
        <p class="text-sm font-medium text-gray-900">{{ item.jabatan }}</p>
        <p class="text-xs text-gray-500">{{ item.total_pegawai ?? 0 }} pegawai</p>
      </div>
      <div class="row-actions">
        <button hx-get="/admin/jabatan/form/{{ item.id }}" hx-target="#modal-host" class="icon-btn">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
        </button>
        <button hx-delete="/admin/jabatan/{{ item.id }}" hx-confirm="Yakin ingin menghapus jabatan ini?" hx-swap="none" class="icon-btn icon-btn-danger">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
        </button>
      </div>
    </div>
    {% endfor %}
  </div>

  {# Desktop #}
  <div class="hidden sm:block overflow-x-auto w-full">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-3">Jabatan</th>
          <th class="px-4 py-3">Slug</th>
          <th class="px-4 py-3 text-center">Jumlah Pegawai</th>
          <th class="px-4 py-3">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {% for item in jabatan %}
        <tr class="hover:bg-gray-50" x-data>
          <td class="px-4 py-3 font-medium text-gray-900">{{ item.jabatan }}</td>
          <td class="px-4 py-3 text-gray-500">{{ item.slug }}</td>
          <td class="px-4 py-3 text-center">
            <span class="badge badge-gray">{{ item.total_pegawai ?? 0 }}</span>
          </td>
          <td class="px-4 py-3">
            <div class="row-actions">
              <button hx-get="/admin/jabatan/form/{{ item.id }}" hx-target="#modal-host" class="icon-btn">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
              </button>
              <button hx-delete="/admin/jabatan/{{ item.id }}" hx-confirm="Yakin ingin menghapus jabatan ini?" hx-swap="none" class="icon-btn icon-btn-danger">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
              </button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}
