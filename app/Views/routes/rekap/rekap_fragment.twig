{# Rekap presensi fragment for HTMX #}
{% if rekap is empty %}
<div class="flex h-64 flex-col items-center justify-center rounded-2xl border border-dashed border-gray-300 bg-gray-50/50">
  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
    <svg class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
    </svg>
  </div>
  <p class="mt-4 text-sm font-medium text-gray-500">Belum ada data presensi pada rentang tanggal ini.</p>
</div>
{% else %}

{# Desktop table #}
<div class="hidden sm:block card overflow-hidden shadow-sm ring-1 ring-black/5">
  <div class="overflow-x-auto w-full">
    <table class="w-full text-left text-sm whitespace-nowrap">
      <thead class="bg-gray-50 border-b border-gray-100 text-xs font-bold uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-4">Tanggal</th>
          <th class="px-6 py-4">Jam Masuk</th>
          <th class="px-6 py-4">Jam Pulang</th>
          <th class="px-6 py-4">Durasi Kerja</th>
          <th class="px-6 py-4">Status Keterlambatan</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        {% for item in rekap %}
        <tr class="transition-colors hover:bg-gray-50/50">
          <td class="px-6 py-4">
            <span class="font-semibold text-gray-900">{{ item.tanggal|date('d M Y') }}</span>
          </td>
          <td class="px-6 py-4">
            <div class="flex items-center gap-2">
              <span class="flex h-2 w-2 rounded-full bg-success-500"></span>
              <span class="font-medium text-gray-700">{{ item.jam_masuk }}</span>
            </div>
          </td>
          <td class="px-6 py-4">
            {% if item.jam_keluar %}
            <div class="flex items-center gap-2">
              <span class="flex h-2 w-2 rounded-full bg-danger-500"></span>
              <span class="font-medium text-gray-700">{{ item.jam_keluar }}</span>
            </div>
            {% else %}
            <span class="text-gray-400 font-medium">-</span>
            {% endif %}
          </td>
          <td class="px-6 py-4 font-medium text-gray-600">{{ item.durasi_kerja ?? '-' }}</td>
          <td class="px-6 py-4">
            {% if item.keterlambatan %}
              <span class="inline-flex items-center rounded-md bg-danger-50 px-2 py-1 text-xs font-bold text-danger-700 ring-1 ring-inset ring-danger-600/20">{{ item.keterlambatan }}</span>
            {% else %}
              <span class="inline-flex items-center rounded-md bg-success-50 px-2 py-1 text-xs font-bold text-success-700 ring-1 ring-inset ring-success-600/20">Tepat Waktu</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{# Mobile cards #}
<div class="sm:hidden space-y-3">
  {% for item in rekap %}
  <div class="card p-5 shadow-sm ring-1 ring-black/5">
    <div class="flex items-center justify-between mb-3 border-b border-gray-100 pb-3">
      <div class="flex items-center gap-2">
        <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="text-sm font-bold text-gray-900">{{ item.tanggal|date('d M Y') }}</span>
      </div>
      {% if item.keterlambatan %}
        <span class="inline-flex items-center rounded-md bg-danger-50 px-2 py-1 text-xs font-bold text-danger-700 ring-1 ring-inset ring-danger-600/20">{{ item.keterlambatan }}</span>
      {% else %}
        <span class="inline-flex items-center rounded-md bg-success-50 px-2 py-1 text-xs font-bold text-success-700 ring-1 ring-inset ring-success-600/20">Tepat Waktu</span>
      {% endif %}
    </div>
    
    <div class="grid grid-cols-2 gap-4">
      <div>
        <span class="block text-xs font-medium text-gray-500 mb-1">Masuk</span>
        <div class="flex items-center gap-1.5">
          <span class="flex h-2 w-2 rounded-full bg-success-500"></span>
          <span class="text-sm font-bold text-gray-900">{{ item.jam_masuk }}</span>
        </div>
      </div>
      <div>
        <span class="block text-xs font-medium text-gray-500 mb-1">Pulang</span>
        {% if item.jam_keluar %}
        <div class="flex items-center gap-1.5">
          <span class="flex h-2 w-2 rounded-full bg-danger-500"></span>
          <span class="text-sm font-bold text-gray-900">{{ item.jam_keluar }}</span>
        </div>
        {% else %}
        <span class="text-sm font-bold text-gray-400">-</span>
        {% endif %}
      </div>
    </div>
    
    {% if item.durasi_kerja %}
    <div class="mt-4 rounded-lg bg-gray-50 p-2.5 text-center">
      <span class="text-xs font-medium text-gray-500">Durasi Kerja:</span>
      <span class="ml-1 text-xs font-bold text-gray-900">{{ item.durasi_kerja }}</span>
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
