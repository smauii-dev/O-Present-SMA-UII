{% extends 'layouts/app.twig' %}
{% block content %}
<div class="mx-auto max-w-4xl">
  <div class="page-toolbar">
    <div class="page-toolbar-meta">
      <p>Pantau catatan kehadiran dan jam kerja Anda.</p>
    </div>
    <div class="page-toolbar-actions">
      <form method="POST" action="/attendance-summary/export">
        <input type="hidden" name="dari" value="{{ tanggal_dari }}">
        <input type="hidden" name="sampai" value="{{ tanggal_sampai }}">
        <button type="submit" class="btn btn-export btn-sm">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Export
        </button>
      </form>
    </div>
  </div>

  <form method="GET" action="/attendance-summary" class="page-filter-bar"
        x-data="{ dari: '{{ tanggal_dari }}', sampai: '{{ tanggal_sampai }}' }">
    <div class="page-filter-field">
      <label for="rekap-dari">Dari tanggal</label>
      <input id="rekap-dari" type="date" name="dari" x-model="dari">
    </div>
    <div class="page-filter-field">
      <label for="rekap-sampai">Sampai tanggal</label>
      <input id="rekap-sampai" type="date" name="sampai" x-model="sampai">
    </div>
    <button type="submit" class="btn btn-dark btn-sm">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
      </svg>
      Terapkan
    </button>
  </form>

  <div id="rekap-list"
       hx-get="/attendance-summary/fragment?dari={{ tanggal_dari }}&sampai={{ tanggal_sampai }}"
       hx-trigger="revealed"
       hx-indicator="#rekap-loading"
       class="min-h-[300px]">
    <div id="rekap-loading" class="flex h-64 flex-col items-center justify-center rounded-2xl border border-dashed border-gray-300 bg-gray-50/50">
      <svg class="mb-4 h-8 w-8 animate-spin text-primary-500" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
      </svg>
      <span class="text-sm font-medium text-gray-500">Mengambil data presensi...</span>
    </div>
  </div>
</div>
{% endblock %}
