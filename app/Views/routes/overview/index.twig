{% extends 'layouts/app.twig' %}

{% set role = user.role ?? authUser.role ?? 'pegawai' %}
{% set isAdmin = role in ['admin', 'head'] %}
{% set firstName = (user.nama ?? authUser.nama ?? 'Pengguna')|split(' ')|first %}

{% block content %}
<div class="overview-page mx-auto max-w-3xl lg:max-w-5xl"
     x-data="overviewClock()"
     x-init="start()">

  {# ── Hero ─────────────────────────────────────────────── #}
  <section class="overview-hero relative overflow-hidden rounded-[1.5rem] p-5 sm:p-7 text-white shadow-lg shadow-primary-900/15">
    <div class="pointer-events-none absolute inset-0 opacity-40"
         style="background:
           radial-gradient(80% 60% at 100% 0%, oklch(1 0 0 / 0.22), transparent 55%),
           radial-gradient(60% 50% at 0% 100%, oklch(0.7 0.12 200 / 0.35), transparent 50%);">
    </div>

    <div class="relative flex items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-white/65">
          {{ todayLabel }}
        </p>
        <h1 class="mt-1.5 text-[1.65rem] sm:text-3xl font-extrabold tracking-tight leading-tight">
          {{ greeting }}, <span class="text-white/95">{{ firstName }}</span>
        </h1>
        <p class="mt-1.5 text-sm text-white/70 truncate">
          {% if isAdmin %}
            Ringkasan operasional kehadiran hari ini
          {% else %}
            {{ user.jabatan ?? authUser.jabatan ?? 'Pegawai' }}
            {% if lokasi %} · {{ lokasi.nama_lokasi }}{% endif %}
          {% endif %}
        </p>
      </div>

      <div class="shrink-0 text-right">
        <p class="font-mono text-2xl sm:text-3xl font-bold tracking-tight tabular-nums" x-text="time">--:--</p>
        <p class="mt-0.5 text-[11px] font-medium uppercase tracking-wider text-white/55" x-text="period"></p>
      </div>
    </div>

    {% if not isAdmin %}
    <div class="relative mt-5 flex flex-wrap items-center gap-2">
      {% if presensi.sudah_pulang %}
        <span class="overview-chip overview-chip-success">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          Selesai hari ini
        </span>
      {% elseif presensi.sudah_masuk %}
        <span class="overview-chip overview-chip-live">
          <span class="h-1.5 w-1.5 rounded-full bg-current animate-pulse"></span>
          Sedang bertugas
        </span>
      {% else %}
        <span class="overview-chip overview-chip-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          Belum clock-in
        </span>
      {% endif %}

      {% if lokasi and lokasi.jam_masuk %}
        <span class="overview-chip overview-chip-ghost">
          Jam kerja {{ lokasi.jam_masuk|slice(0,5) }}–{{ lokasi.jam_pulang|slice(0,5) }}
        </span>
      {% endif %}
    </div>
    {% endif %}
  </section>

  {% if isAdmin %}
  {# ── Admin stats ──────────────────────────────────────── #}
  <section class="mt-5 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <article class="overview-stat">
      <div class="overview-stat-icon bg-primary-50 text-primary-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
      </div>
      <p class="overview-stat-value">{{ stats.pegawai_aktif ?? 0 }}</p>
      <p class="overview-stat-label">Pegawai aktif</p>
    </article>

    <article class="overview-stat">
      <div class="overview-stat-icon bg-success-50 text-success-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="overview-stat-value">{{ stats.pegawai_hadir ?? 0 }}</p>
      <p class="overview-stat-label">Hadir hari ini</p>
    </article>

    <article class="overview-stat">
      <div class="overview-stat-icon bg-warning-50 text-warning-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <p class="overview-stat-value">{{ stats.pegawai_izin ?? 0 }}</p>
      <p class="overview-stat-label">Izin / cuti</p>
    </article>

    <article class="overview-stat">
      <div class="overview-stat-icon bg-danger-50 text-danger-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
      </div>
      <p class="overview-stat-value">{{ stats.pegawai_alpha ?? 0 }}</p>
      <p class="overview-stat-label">Belum hadir</p>
    </article>
  </section>

  <section class="mt-6">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-semibold tracking-tight text-gray-900">Aksi cepat</h2>
      <span class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">Admin</span>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <a href="/admin/pegawai" class="overview-action">
        <span class="overview-action-icon bg-primary-50 text-primary-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" /></svg>
        </span>
        <span class="overview-action-label">Pegawai</span>
      </a>
      <a href="/admin/absence/admin" class="overview-action">
        <span class="overview-action-icon bg-warning-50 text-warning-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>
        </span>
        <span class="overview-action-label">Review izin</span>
      </a>
      <a href="/admin/jabatan" class="overview-action">
        <span class="overview-action-icon bg-gray-100 text-gray-700">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
        </span>
        <span class="overview-action-label">Jabatan</span>
      </a>
      <a href="/admin/lokasi" class="overview-action">
        <span class="overview-action-icon bg-primary-50 text-primary-700">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
        </span>
        <span class="overview-action-label">Lokasi</span>
      </a>
    </div>
  </section>

  {% else %}
  {# ── Pegawai attendance card ──────────────────────────── #}
  <section class="mt-5">
    <div class="overview-panel">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Status kehadiran</h2>
          <p class="mt-0.5 text-xs text-gray-500">Pencatatan otomatis berbasis lokasi & foto</p>
        </div>
        {% if presensi.sudah_pulang %}
          <span class="badge badge-success">Selesai</span>
        {% elseif presensi.sudah_masuk %}
          <span class="badge badge-primary">Aktif</span>
        {% else %}
          <span class="badge badge-gray">Menunggu</span>
        {% endif %}
      </div>

      <div class="mt-5 grid grid-cols-2 gap-3">
        <div class="rounded-2xl bg-gray-50/90 p-4 ring-1 ring-gray-100">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Clock-in</p>
          <p class="mt-1 text-xl font-bold tabular-nums text-gray-900">
            {{ presensi.data and presensi.data.jam_masuk ? presensi.data.jam_masuk|slice(0,5) : '—' }}
          </p>
        </div>
        <div class="rounded-2xl bg-gray-50/90 p-4 ring-1 ring-gray-100">
          <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Clock-out</p>
          <p class="mt-1 text-xl font-bold tabular-nums text-gray-900">
            {{ presensi.data and presensi.data.jam_keluar ? presensi.data.jam_keluar|slice(0,5) : '—' }}
          </p>
        </div>
      </div>

      {% if durasi_kerja or keterlambatan %}
      <div class="mt-3 flex flex-wrap gap-2">
        {% if durasi_kerja %}
          <span class="overview-meta">Durasi {{ durasi_kerja }}</span>
        {% endif %}
        {% if keterlambatan %}
          <span class="overview-meta overview-meta-warn">Terlambat {{ keterlambatan }}</span>
        {% endif %}
      </div>
      {% endif %}

      <div class="mt-5">
        {% if not presensi.sudah_masuk %}
          <a href="/presence" class="btn btn-primary btn-lg btn-block">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
            Lakukan clock-in
          </a>
        {% elseif not presensi.sudah_pulang %}
          <a href="/presence" class="btn btn-success btn-lg btn-block">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
            Lakukan clock-out
          </a>
        {% else %}
          <a href="/attendance-summary" class="btn btn-secondary btn-lg btn-block">
            Lihat rekap kehadiran
          </a>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="mt-6">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-sm font-semibold tracking-tight text-gray-900">Menu utama</h2>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <a href="/presence" class="overview-action">
        <span class="overview-action-icon bg-primary-50 text-primary-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </span>
        <span class="overview-action-label">Presensi</span>
      </a>
      <a href="/attendance-summary" class="overview-action">
        <span class="overview-action-icon bg-gray-100 text-gray-700">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        </span>
        <span class="overview-action-label">Rekap</span>
      </a>
      <a href="/absence" class="overview-action">
        <span class="overview-action-icon bg-warning-50 text-warning-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
        </span>
        <span class="overview-action-label">Izin & cuti</span>
      </a>
      <a href="/profile" class="overview-action sm:col-span-1 col-span-2 sm:col-auto">
        <span class="overview-action-icon bg-primary-50 text-primary-700">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
        </span>
        <span class="overview-action-label">Profil</span>
      </a>
    </div>
  </section>
  {% endif %}

  {# ── Trust footer strip ───────────────────────────────── #}
  <p class="mt-8 mb-2 text-center text-[11px] font-medium tracking-wide text-gray-400">
    O-Present · SMA UII Yogyakarta
  </p>
</div>

<script>
function overviewClock() {
  return {
    time: '--:--',
    period: '',
    _timer: null,
    start() {
      this.tick();
      this._timer = setInterval(() => this.tick(), 1000);
    },
    tick() {
      const now = new Date();
      this.time = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', hour12: false });
      const h = now.getHours();
      this.period = h < 12 ? 'Pagi' : h < 15 ? 'Siang' : h < 18 ? 'Sore' : 'Malam';
    },
    destroy() {
      if (this._timer) clearInterval(this._timer);
    }
  };
}
</script>
{% endblock %}
