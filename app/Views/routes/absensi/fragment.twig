{# Ketidakhadiran list fragment #}
{% if ketidakhadiran is empty %}
<div class="flex h-64 flex-col items-center justify-center rounded-2xl border border-dashed border-gray-300 bg-gray-50/50">
  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
    <svg class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
    </svg>
  </div>
  <p class="mt-4 text-sm font-medium text-gray-500">Belum ada pengajuan izin / cuti.</p>
</div>
{% else %}
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {% for item in ketidakhadiran %}
  <div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5 transition-all hover:shadow-md hover:ring-black/10">
    <div>
      <div class="mb-4 flex items-start justify-between">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold ring-1 ring-inset {{ item.tipe_ketidakhadiran == 'SAKIT' ? 'bg-warning-50 text-warning-700 ring-warning-600/20' : (item.tipe_ketidakhadiran == 'CUTI' ? 'bg-primary-50 text-primary-700 ring-primary-600/20' : 'bg-gray-50 text-gray-700 ring-gray-600/20') }}">
            {{ item.tipe_ketidakhadiran }}
          </span>
          <span class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-bold ring-1 ring-inset {{ item.status_pengajuan == 'APPROVED' ? 'bg-success-50 text-success-700 ring-success-600/20' : (item.status_pengajuan == 'REJECTED' ? 'bg-danger-50 text-danger-700 ring-danger-600/20' : 'bg-warning-50 text-warning-700 ring-warning-600/20') }}">
            {{ item.status_pengajuan }}
          </span>
        </div>
        
        {# Actions Menu #}
        <div class="row-actions shrink-0">
          {% if isAdmin is defined and isAdmin %}
            {% if item.status_pengajuan == 'PENDING' %}
            <button type="button" hx-post="/admin/absence/admin/status/{{ item.id }}" hx-vals='{"status_pengajuan": "APPROVED"}' hx-swap="none" class="icon-btn icon-btn-success" title="Setujui">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
            </button>
            <button type="button" hx-post="/admin/absence/admin/status/{{ item.id }}" hx-vals='{"status_pengajuan": "REJECTED"}' hx-swap="none" class="icon-btn icon-btn-danger-solid" title="Tolak">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            {% endif %}
          {% else %}
            {% if item.status_pengajuan == 'PENDING' %}
            <button type="button" hx-get="/absence/form/{{ item.id }}" hx-target="#modal-host" class="icon-btn" title="Edit">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
            </button>
            <button type="button" hx-delete="/absence/{{ item.id }}" hx-confirm="Yakin ingin membatalkan pengajuan ini?" hx-swap="none" class="icon-btn icon-btn-danger" title="Hapus">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
            </button>
            {% endif %}
          {% endif %}
        </div>
      </div>
      
      <div class="mb-3">
        <h3 class="font-bold text-gray-900">{{ item.tanggal_mulai|date('d M Y') }}</h3>
        {% if item.tanggal_mulai != item.tanggal_berakhir %}
        <p class="text-sm font-medium text-gray-500">s/d {{ item.tanggal_berakhir|date('d M Y') }}</p>
        {% endif %}
      </div>
      
      {% if item.deskripsi %}
      <div class="rounded-xl bg-gray-50 p-3 text-sm text-gray-600">
        <p class="line-clamp-3">{{ item.deskripsi }}</p>
      </div>
      {% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}
