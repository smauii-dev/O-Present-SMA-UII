<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="csrf-token" content="{{ csrf_hash() }}">
  <title>{{ pageTitle is defined ? pageTitle ~ ' - ' }}O-Present SMA UII</title>
  <link rel="icon" href="/assets/logo.png" type="image/png">
  {{ vite_css('main.ts')|raw }}
  {% block head %}{% endblock %}
  <script type="module" src="{{ vite('main.ts') }}"></script>
  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('toaster', () => ({
        toasts: [],
        addToast(toast) {
          const id = crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2);
          if (this.toasts.length >= 5) this.toasts.shift();
          const remaining = 4000;
          const t = { id, ...toast, remaining, startTime: Date.now(), paused: false, timer: null };
          this.toasts.push(t);
          this.startTimer(t);
        },
        startTimer(t) {
          if (t.timer) clearTimeout(t.timer);
          t.timer = setTimeout(() => {
            this.toasts = this.toasts.filter(x => x.id !== t.id);
          }, t.remaining);
        },
        pauseToast(id) {
          const t = this.toasts.find(x => x.id === id);
          if (t && !t.paused) {
            t.remaining -= (Date.now() - t.startTime);
            t.paused = true;
            if (t.timer) clearTimeout(t.timer);
          }
        },
        resumeToast(id) {
          const t = this.toasts.find(x => x.id === id);
          if (t && t.paused) {
            t.paused = false;
            t.startTime = Date.now();
            this.startTimer(t);
          }
        }
      }));
    });
  </script>
</head>
<body class="bg-gray-50 text-gray-900 antialiased {% block body_class %}{% endblock %}">
  {# Capture flash once — reusable by toast + auth sheet (getFlashdata consumes) #}
  {% set flashSuccess = session.getFlashdata('success') %}
  {% set flashError = session.getFlashdata('error') %}
  {% set flashInfo = session.getFlashdata('info') %}
  {% set flashWarning = session.getFlashdata('warning') %}

  {# Alpine + HTMX Toaster — skipped on auth-page (inline sheet alerts instead) #}
  <div id="toast-container"
       class="fixed top-4 right-4 z-[9999] flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"
       style="top: max(1rem, env(safe-area-inset-top)); right: max(0, env(safe-area-inset-right));"
       x-data="toaster()"
       @toast.window="addToast($event.detail)">

    {% block flash_toasts %}
    {% if flashSuccess %}
      <div x-init="addToast({ type: 'success', message: '{{ flashSuccess|e('js') }}' })"></div>
    {% endif %}
    {% if flashError %}
      <div x-init="addToast({ type: 'error', message: '{{ flashError|e('js') }}' })"></div>
    {% endif %}
    {% if flashInfo %}
      <div x-init="addToast({ type: 'info', message: '{{ flashInfo|e('js') }}' })"></div>
    {% endif %}
    {% if flashWarning %}
      <div x-init="addToast({ type: 'warning', message: '{{ flashWarning|e('js') }}' })"></div>
    {% endif %}
    {% endblock %}

    <template x-for="toast in toasts" :key="toast.id">
      <div :class="{
             'bg-success-600': toast.type === 'success',
             'bg-danger-600': toast.type === 'error',
             'bg-primary-600': toast.type === 'info',
             'bg-warning-600': toast.type === 'warning'
           }"
           class="text-white px-4 py-3 rounded-lg shadow-lg text-sm font-medium transform transition-all duration-300 pointer-events-auto flex items-center justify-between"
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0 translate-y-2"
           x-transition:enter-end="opacity-100 translate-y-0"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100 translate-y-0"
           x-transition:leave-end="opacity-0 -translate-y-2"
           @mouseenter="pauseToast(toast.id)"
           @mouseleave="resumeToast(toast.id)">
        <span x-text="toast.message"></span>
        <button @click="toasts = toasts.filter(t => t.id !== toast.id)" class="ml-4 shrink-0 opacity-75 hover:opacity-100">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </template>
  </div>

  {% block body %}{% endblock %}

  {# Body-level modal host — HTMX loads modal content here #}
  <div id="modal-host"></div>
</body>
</html>
