{# 
  Modal Shell Macro (open/close pair)

  Twig macros cannot capture body content like Vue slots. Use open + end:

    {% import 'partials/modal.twig' as modal %}
    {{ modal.modal('unique-id', 'Modal Title', 'md', true) }}
      <form ...>...</form>
    {{ modal.end() }}
#}

{% macro modal(id, title, size='md', centered=true, closeEvent=null) %}
{% set centeredBool = centered ? 'true' : 'false' %}
<div 
  id="{{ id }}-modal-backdrop" 
  x-data="modal({ size: '{{ size }}', centered: {{ centeredBool }}, closeOnBackdrop: true, closeOnEscape: true })"
  x-show="open" 
  x-cloak
  @close-modal.window="hide()"
  @keydown.escape.window="handleKeydown($event)"
  @click.self="handleBackdropClick($event)"
  class="{{ centered ? 'items-center justify-center' : 'items-end justify-center sm:items-center' }} fixed inset-0 z-50 flex p-4 bg-black/50 transition-opacity duration-200"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="{{ id }}-modal-title"
  {% if closeEvent %}
  @{{ closeEvent }}.window="hide()"
  {% endif %}
>
  <div 
    x-ref="panel"
    x-show="open"
    class="relative w-full rounded-2xl bg-white p-6 shadow-xl max-h-[85vh] overflow-y-auto {{ 
      size == 'sm' ? 'max-w-sm' : 
      (size == 'md' ? 'max-w-md' : 
      (size == 'lg' ? 'max-w-lg' : 
      (size == 'xl' ? 'max-w-xl' : 'max-w-4xl'))) }}"
    @click.stop
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 scale-95 translate-y-4"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 scale-100 translate-y-0"
    x-transition:leave-end="opacity-0 scale-95 translate-y-4"
  >
    <h3 id="{{ id }}-modal-title" class="mb-4 text-lg font-semibold">{{ title }}</h3>
{% endmacro %}

{% macro end() %}
  </div>
</div>
{% endmacro %}
