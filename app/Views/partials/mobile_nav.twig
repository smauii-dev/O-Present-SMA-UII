{# Mobile bottom nav — Home · Presensi · Izin (profile di header)
   Dipasang sebagai sibling .app-main di layouts/app.twig agar fixed + center viewport. #}
{% set role = authUser.role ?? authUser.group ?? 'pegawai' %}
{% set isAdmin = role in ['admin', 'head'] %}
{% set isHome = currentUrl == 'overview' or currentUrl == '' %}
{% set isPresensi = currentUrl == 'presence' or currentUrl starts with 'presence/' or currentUrl == 'attendance-summary' or currentUrl starts with 'attendance-summary/' %}
{% set isIzin = currentUrl starts with 'absence' or currentUrl starts with 'admin/absence/admin' %}
{% set izinHref = isAdmin ? '/admin/absence/admin' : '/absence' %}

<nav class="mobile-nav lg:hidden"
     role="navigation"
     aria-label="Navigasi utama">
  <div class="mobile-nav-inner">

    {# 1. Home #}
    <a href="/overview"
       class="mobile-nav-item {{ isHome ? 'is-active' : '' }}"
       {% if isHome %}aria-current="page"{% endif %}>
      <span class="mobile-nav-icon" aria-hidden="true">
        <svg class="h-[1.375rem] w-[1.375rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="{{ isHome ? '2' : '1.5' }}">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
      </span>
      <span class="mobile-nav-label">Home</span>
    </a>

    {# 2. Presensi (FAB tengah) #}
    <a href="/presence"
       class="mobile-nav-item mobile-nav-item--primary {{ isPresensi ? 'is-active' : '' }}"
       {% if isPresensi %}aria-current="page"{% endif %}>
      <span class="mobile-nav-fab" aria-hidden="true">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </span>
      <span class="mobile-nav-label">Presensi</span>
    </a>

    {# 3. Izin #}
<a href="{{ izinHref }}"
        class="mobile-nav-item {{ isIzin ? 'is-active' : '' }}"
        {% if isIzin %}aria-current="page"{% endif %}>
      <span class="mobile-nav-icon" aria-hidden="true">
        <svg class="h-[1.375rem] w-[1.375rem]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="{{ isIzin ? '2' : '1.5' }}">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </span>
      <span class="mobile-nav-label">Izin</span>
    </a>

  </div>
</nav>
