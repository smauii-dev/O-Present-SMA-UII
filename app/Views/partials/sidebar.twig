{# Sidebar navigation #}
<aside class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-gray-200 transform transition-transform duration-200 -translate-x-full lg:translate-x-0"
       :class="{'translate-x-0': sidebarOpen}">

  {# Logo #}
  <div class="flex h-16 items-center gap-3 border-b border-gray-200 px-4">
    <div class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-lg bg-gray-50 p-1 ring-1 ring-gray-200">
      <img src="/assets/logo.png" alt="Logo" class="h-full w-full object-contain">
    </div>
    <div>
      <h1 class="text-sm font-bold text-gray-900">O-Present</h1>
      <p class="text-[10px] text-gray-500">SMA UII Yogyakarta</p>
    </div>
    <button @click="sidebarOpen = false" class="ml-auto lg:hidden p-1 rounded-lg hover:bg-gray-100">
      <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  {# Navigation #}
  <nav class="flex-1 overflow-y-auto p-3 space-y-1">
    {% set role = authUser.role ?? authUser.group ?? 'pegawai' %}
    {% set isAdmin = role in ['admin', 'head'] %}
    {% set isOverview = currentUrl == 'overview' or currentUrl == '' %}

    {# Overview #}
    <a href="/overview"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ isOverview ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
      </svg>
      Overview
    </a>

    {% if not isAdmin %}
    {# Presensi (Pegawai only) #}
    <a href="/presence"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ currentUrl == 'presence' or currentUrl starts with 'presence/' ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Presensi
    </a>

    <a href="/attendance-summary"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ currentUrl == 'attendance-summary' or currentUrl starts with 'attendance-summary/' ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
      Rekap Presensi
    </a>
    {% endif %}

    <a href="/absence"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ currentUrl starts with 'absence' ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
      </svg>
      Ketidakhadiran
    </a>

    {% if isAdmin %}
    <div class="pt-3 mt-3 border-t border-gray-200">
      <p class="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Admin</p>
    </div>

    <a href="/admin/pegawai"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ currentUrl starts with 'admin/pegawai' ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
      </svg>
      Data Pegawai
    </a>

    <a href="/admin/jabatan"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ currentUrl starts with 'admin/jabatan' ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
      </svg>
      Jabatan
    </a>

    <a href="/admin/lokasi"
       class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors
              {{ currentUrl starts with 'admin/lokasi' ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-100' }}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
      </svg>
      Lokasi Presensi
    </a>
    {% endif %}

  </nav>

  {# User info at bottom #}
  <div class="absolute bottom-0 left-0 right-0 border-t border-gray-200 bg-white p-3">
    <div class="flex items-center gap-3">
      <div class="h-9 w-9 shrink-0 overflow-hidden rounded-full bg-gray-200">
        {% if authUser and authUser.foto_url %}
          <img src="{{ authUser.foto_url }}" alt="" class="h-full w-full object-cover" loading="lazy">
        {% else %}
          <div class="flex h-full w-full items-center justify-center bg-primary-100 text-sm font-bold text-primary-700">
            {{ authUser.nama|first|upper|default('U') }}
          </div>
        {% endif %}
      </div>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-gray-900">{{ authUser.nama ?? 'User' }}</p>
        <p class="truncate text-xs text-gray-500">{{ authUser.role|default('') }}</p>
      </div>
      <form method="POST" action="/logout">
        <button type="submit" class="icon-btn" title="Logout">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</aside>
