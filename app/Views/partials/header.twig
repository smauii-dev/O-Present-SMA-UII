{# Header bar #}
<header class="sticky top-0 z-30 flex h-16 items-center gap-4 border-b border-gray-200 bg-white/80 backdrop-blur-md px-4 sm:px-6">
  {# Mobile hamburger #}
  <button @click="sidebarOpen = true" class="p-2 rounded-lg text-gray-600 hover:bg-gray-100 lg:hidden">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
    </svg>
  </button>

  {# Page title #}
  <div class="flex-1">
    <h2 class="text-lg font-semibold text-gray-900">{{ pageTitle is defined ? pageTitle : 'Overview' }}</h2>
  </div>

  {# User profile link (responsive) #}
  <div class="flex items-center gap-2">
    <a href="/profile" class="flex items-center gap-2 rounded-full focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 hover:opacity-80 transition-opacity">
      <div class="h-8 w-8 overflow-hidden rounded-full bg-gray-200 ring-1 ring-gray-300">
        {% if authUser and authUser.foto_url %}
          <img src="{{ authUser.foto_url }}" alt="" class="h-full w-full object-cover" loading="lazy">
        {% else %}
          <div class="flex h-full w-full items-center justify-center bg-primary-100 text-xs font-bold text-primary-700">
            {{ authUser.nama|first|upper|default('U') }}
          </div>
        {% endif %}
      </div>
    </a>
  </div>
</header>
